VAULTWARDEN_DOMAIN=vault.cinestats5050.fr
VAULTWARDEN_ADMIN_TOKEN=changeme-generate-a-long-random-token
VAULTWARDEN_SIGNUPS_ALLOWED=false

# SMTP (optionnel, pour les invitations par email)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls

# SSO OIDC via Authentik (client OAuth défini côté Authentik par blueprint)
AUTHENTIK_VW_CLIENT_ID=changeme
AUTHENTIK_VW_CLIENT_SECRET=changeme
