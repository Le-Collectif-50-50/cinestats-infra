# Docker socket (macOS: ~/.docker/run/docker.sock, Linux: /var/run/docker.sock)
# DOCKER_SOCK=/var/run/docker.sock

ACME_EMAIL=admin@collectif5050.fr

METABASE_DOMAIN=metabase.cinestats5050.fr

MB_DB_USER=metabase
MB_DB_PASSWORD=changeme
MB_DB_NAME=metabase

# Doit correspondre à METABASE_SECRET_KEY dans le repo CineStats
MB_EMBEDDING_SECRET_KEY=changeme-match-cinestats-env

# SMTP (Brevo) — mêmes identifiants que vaultwarden/.env.example et authentik/.env.example
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=changeme
SMTP_PASSWORD=changeme
SMTP_FROM=noreply@cinestats5050.fr
