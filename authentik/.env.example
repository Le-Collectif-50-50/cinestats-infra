AUTHENTIK_DOMAIN=auth.cinestats5050.fr
AUTHENTIK_SECRET_KEY=changeme-generate-a-long-random-secret

AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=changeme
AUTHENTIK_DB_NAME=authentik

# Compte admin initial (akadmin) créé au tout premier démarrage (si aucun user)
AUTHENTIK_BOOTSTRAP_EMAIL=admin@cinestats5050.fr
AUTHENTIK_BOOTSTRAP_PASSWORD=changeme

# Email (SMTP) — ex. Brevo : smtp-relay.brevo.com / 587 / TLS
AUTHENTIK_EMAIL__HOST=smtp-relay.brevo.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=changeme
AUTHENTIK_EMAIL__PASSWORD=changeme
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=noreply@cinestats5050.fr

# Clients OIDC déclarés par les blueprints (authentik/blueprints/*.yaml)
AUTHENTIK_GRAFANA_CLIENT_ID=changeme
AUTHENTIK_GRAFANA_CLIENT_SECRET=changeme
AUTHENTIK_VW_CLIENT_ID=changeme
AUTHENTIK_VW_CLIENT_SECRET=changeme
