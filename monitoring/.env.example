GRAFANA_DOMAIN=grafana.cinestats5050.fr
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

BUGSINK_DOMAIN=bugsink.cinestats5050.fr
BUGSINK_SECRET_KEY=changeme-generate-a-random-secret-min-50-chars
BUGSINK_DB_USER=bugsink
BUGSINK_DB_PASSWORD=changeme
BUGSINK_DB_NAME=bugsink
# Superuser créé au premier démarrage (uniquement si aucun user n'existe)
BUGSINK_SUPERUSER_EMAIL=admin@cinestats5050.fr
BUGSINK_SUPERUSER_PASSWORD=changeme

# DSN de la Managed DB OVH (BDD applicative CineStats) pour postgres-exporter
POSTGRES_EXPORTER_DSN=postgresql://exporter:changeme@db-host:5432/cinestats?sslmode=require

# SSO OIDC Grafana via Authentik (client OAuth défini côté Authentik par blueprint)
AUTHENTIK_GRAFANA_CLIENT_ID=changeme
AUTHENTIK_GRAFANA_CLIENT_SECRET=changeme
